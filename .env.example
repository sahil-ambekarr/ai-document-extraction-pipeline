# Which LLM backend to use: ollama (default) | claude | mock
LLM_PROVIDER=ollama

# Extraction mode: auto | text | vision
# auto = text when the PDF has a usable text layer, otherwise vision
EXTRACTION_MODE=auto

# Validation retry loop: total attempts per document (1 = no retry)
MAX_ATTEMPTS=3

# --- Ollama ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TEXT_MODEL=llama3.2
OLLAMA_VISION_MODEL=qwen2.5vl:3b
# Seconds to wait for one model response (CPU-only inference is slow)
LLM_TIMEOUT_SECONDS=900

# --- Claude (only used when LLM_PROVIDER=claude) ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5

# --- Mock (tests / CI) ---
MOCK_RESPONSES_DIR=data/mock_responses

# --- Storage ---
# SQLite by default. SQL Server example (not verified locally, needs `pip install pyodbc`):
# DATABASE_URL=mssql+pyodbc://sa:<your-password>@localhost:1433/extraction?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes
DATABASE_URL=sqlite:///var/extraction.db
STORAGE_DIR=var/pages

# --- Rendering / limits ---
MAX_PAGES=4
MAX_UPLOAD_MB=15
VISION_MAX_SIDE=1280

PORT=4102
LOG_LEVEL=INFO
